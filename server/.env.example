PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set a random 32+ character secret before deploying. Development generates one automatically.
JWT_SECRET=
# Defaults to true in production. Set false only for local HTTP Docker use.
COOKIE_SECURE=
# Local JSON storage starts immediately; set MongoDB for multi-process production.
MONGODB_URI=
REDIS_URL=
DATA_DIR=./data
AI_PROVIDER=local
# Set AI_PROVIDER=openai and supply your own key to enable real AI extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_UPLOAD_MB=15
MAX_DOCUMENTS=100
# Optional outside Docker, required for legacy DOC/XLS and scanned PDFs.
LIBREOFFICE_BIN=
PDFTOPPM_BIN=
OCR_LANG=eng+hin
# Optional path to a human-approved release folder containing eng.traineddata and hin.traineddata.
OCR_MODEL_DIR=
# Training lab is local-only and always disabled in production.
LOCAL_TRAINING=true
# Existing local Linux distribution for native Windows training (Docker is optional).
TRAINING_WSL_DISTRO=Ubuntu
